# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.qodo

# Local Claude Code settings (personal, not shared)
.claude/settings.local.json

# UI restyle: baseline in docs/ui-restyle/screenshots/before is committed on
# purpose (a frozen baseline that is not versioned is not frozen). The "after"
# set is regenerated after every batch and must not be committed.
docs/ui-restyle/screenshots/after/

# Playwright: saved sign-in state for UI capture runs. Never commit.
.auth/
test-results/
playwright-report/
